# Configuración para el despliegue en AWS S3 y CloudFront
# Copia este archivo como .env y completa con tus datos:
# cp .env.example .env

# Nombre del bucket S3 de destino
S3_BUCKET=tu-bucket-aqui

# ID de la distribución de CloudFront (ejemplo: E1A2B3C4D5E6F7)
CLOUDFRONT_DISTRIBUTION_ID=tu-distribution-id-aqui

# Región de AWS (opcional, por defecto us-east-1 si no se especifica)
AWS_REGION=us-east-1

# Perfil de AWS CLI (opcional, descomenta si usas un perfil específico de ~/.aws/credentials)
# AWS_PROFILE=default
